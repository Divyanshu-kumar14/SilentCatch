# Copy to `.env` and fill in. When unset, backend runs in REPLAYED mode (PRD §7).
# Never commit real keys — .env is git-ignored.

# --- Backend (server-side only; never exposed to the browser) ---
NEBIUS_API_KEY=
TAVILY_API_KEY=

# --- Backend CORS: exact browser origins, comma-separated ---
# Defaults: https://silentcatch.vercel.app, http://localhost:3000,
# http://127.0.0.1:3000. Add preview deployments explicitly; the regex
# escape hatch is opt-in and never trusts every *.vercel.app tenant.
# ALLOWED_ORIGINS=https://silentcatch.vercel.app,http://localhost:3000
# ALLOWED_ORIGIN_REGEX=^https://silentcatch-[a-z0-9-]+\.vercel\.app$

# --- Frontend (build-time, public — never put secrets here) ---
# Canonical backend origin used by the browser (SSE, audit, scan images).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Legacy alias, only read when NEXT_PUBLIC_API_URL is unset.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
